<!DOCTYPE html>
<html lang="es" class="bg-black">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Pizza Arcade</title>

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>
<body class="bg-black text-light font-monospace min-vh-100 d-flex flex-column">

    <!-- Navegación Simplificada -->
    <nav class="navbar navbar-dark bg-dark border-bottom border-danger sticky-top">
        <div class="container justify-content-center">
            <a class="navbar-brand fw-bold text-danger fs-2 d-flex align-items-center gap-2 m-0" asp-controller="Home" asp-action="Index">
                <i class="bi bi-controller"></i> PIZZA ARCADE
            </a>
        </div>
    </nav>

    <!-- Contenido Dinámico de las Vistas -->
    <main role="main">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="mt-auto py-3 bg-dark text-center border-top border-danger">
        <div class="container">
            <small class="text-muted">Pizza Arcade. Todos los derechos reservados.</small>
        </div>
    </footer>

    <!-- Bootstrap 5 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>